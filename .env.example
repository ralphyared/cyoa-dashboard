# Copy to .env and fill in.

# The dashboard login password.
CYOA_PASSWORD=change-me

# Host user/group that owns ./data (run `id` to see yours).
CYOA_UID=1000
CYOA_GID=1000

# Optional
# CYOA_SECURE_COOKIES=true        # keep true behind HTTPS
# CYOA_SESSION_DAYS=30
# CYOA_BACKUP_KEEP=14             # daily automatic backups to keep
# CYOA_PLAYTEST_LIMIT=4           # simultaneous playtest terminals
# CYOA_PLAYTEST_IDLE_MINUTES=60
